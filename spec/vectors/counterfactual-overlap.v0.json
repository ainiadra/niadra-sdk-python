{
  "vectors": "counterfactual-overlap",
  "version": "v0",
  "spec": "spec/counterfactual.md",
  "cases": [
    {
      "id": "counterfactual.overlap.same_list_overlaps_one",
      "description": "Two equal lists of ten.",
      "a": [
        "item_variant:store:a1",
        "item_variant:store:a2",
        "item_variant:store:a3",
        "item_variant:store:a4",
        "item_variant:store:a5",
        "item_variant:store:a6",
        "item_variant:store:a7",
        "item_variant:store:a8",
        "item_variant:store:a9",
        "item_variant:store:a10"
      ],
      "b": [
        "item_variant:store:a1",
        "item_variant:store:a2",
        "item_variant:store:a3",
        "item_variant:store:a4",
        "item_variant:store:a5",
        "item_variant:store:a6",
        "item_variant:store:a7",
        "item_variant:store:a8",
        "item_variant:store:a9",
        "item_variant:store:a10"
      ],
      "k": 10,
      "expect": {
        "overlap": 1.0
      }
    },
    {
      "id": "counterfactual.overlap.reversed",
      "description": "The same five items in reverse order.",
      "a": [
        "item_variant:store:a1",
        "item_variant:store:a2",
        "item_variant:store:a3",
        "item_variant:store:a4",
        "item_variant:store:a5"
