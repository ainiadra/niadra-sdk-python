      "b": [
        "item_variant:store:a5",
        "item_variant:store:a4",
        "item_variant:store:a3",
        "item_variant:store:a2",
        "item_variant:store:a1"
      ],
      "k": 5,
      "expect": {
        "overlap": 0.297283
      }
    },
    {
      "id": "counterfactual.overlap.disjoint",
      "description": "No item in common.",
      "a": [
        "item_variant:store:a1",
        "item_variant:store:a2",
        "item_variant:store:a3"
      ],
      "b": [
        "item_variant:store:b1",
